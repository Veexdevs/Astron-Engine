    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Astron.iOSApp</RootNamespace>
    <AssemblyName>AstronGame.iOS</AssemblyName>
    <ApplicationId>com.astron.engine.game</ApplicationId>
    <ApplicationTitle>Astron Game</ApplicationTitle>
